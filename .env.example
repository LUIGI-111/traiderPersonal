# Copia a .env y rellena. NUNCA subas .env a git.
ANTHROPIC_API_KEY=
TD_MODEL=claude-sonnet-5-5

# Capital simulado inicial
TD_STARTING_CASH=100000

# Límites de riesgo (los agentes NO pueden saltárselos)
TD_MAX_POSITION_PCT=0.05      # máx. 5% del portafolio por posición
TD_MAX_EXPOSURE_PCT=0.60      # máx. 60% invertido en total
TD_RISK_PER_TRADE_PCT=0.01    # arriesgar máx. 1% del equity por operación
TD_STOP_ATR_MULT=2.0          # stop-loss = 2 x ATR
TD_MIN_CONFIDENCE=0.60        # confianza mínima para operar
TD_MAX_DRAWDOWN_PCT=0.10      # kill-switch: si cae 10% desde el máximo, no se compra más

TD_STATE_DIR=data
